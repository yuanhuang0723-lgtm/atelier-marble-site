NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
NEXT_PUBLIC_GOOGLE_ADS_ID=AW-XXXXXXXXXX
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_LABEL=XXXXXXXXXXXXXXX
NEXT_PUBLIC_SITE_URL=https://ateliermarblestone.com
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_INQUIRY_BUCKET=inquiry-files
# Optional: otherwise the service-role key is used server-side to sign upload receipts.
INQUIRY_UPLOAD_SECRET=
INQUIRY_RECIPIENT=ding@atelier-marble.ltd
# Temporary, explicit degraded mode: allow no-file inquiries to use FormSubmit
# when Supabase is unavailable. Keep false/unset when durable idempotency works.
INQUIRY_DEGRADED_NO_FILE_FALLBACK=false
# Optional Aliyun Enterprise Mail SMTP transport. When SMTP_PASS is configured,
# SMTP is used instead of FormSubmit. Leave blank until mailbox SMTP access is ready.
SMTP_HOST=smtp.qiye.aliyun.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
