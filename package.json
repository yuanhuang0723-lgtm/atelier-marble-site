{
  "name": "atelier-marble",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "next build",
    "dev": "next dev",
    "clean": "node -e \"require('fs').rmSync('.next', { recursive: true, force: true })\"",
    "dev:fresh": "npm run clean && next dev",
    "prebuild": "npm run audit:assets",
    "start": "next start",
    "prepare:assets": "node scripts/prepare-assets.mjs",
    "audit:assets": "node scripts/audit-assets.mjs",
    "audit:seo": "node scripts/audit-seo.mjs",
    "check:public": "node scripts/check-public-routes.mjs",
    "test:inquiry": "tsx --test tests/inquiry-*.test.ts",
    "test:browser": "node scripts/browser-inquiry-smoke.mjs",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.6",
    "@supabase/supabase-js": "^2.115.0",
    "lucide-react": "^0.468.0",
    "next": "^16.3.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "0.35.4"
  },
  "overrides": {
    "sharp": "0.35.4"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "@types/react": "^19.2.17",
    "autoprefixer": "^10.5.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.4",
    "playwright": "^1.63.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "wrangler": "^4.129.0"
  }
}
